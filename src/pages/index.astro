---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import { Picture } from "astro:assets";
import Badge from "~/components/Badge.astro";
import Button from "~/components/Button.astro";
import ButtonCallUs from "~/components/ButtonCallUs.astro";
import Grid from "~/components/Grid.astro";
import Heading from "~/components/Heading.astro";
import WideImage from "~/components/WideImage.astro";
import ReviewSlider from "~/components/ReviewSlider.astro";

// Images
import prato from "~/assets/images/prato.jpeg";
import burgerFeature from "~/assets/images/burger.JPG";
import burgerShowcase from "~/assets/images/menuSwissBurgerDois.JPG";
import prepOne from "~/assets/images/preparacao.JPG";
import fries from "~/assets/images/fritas.JPG";
import onionRings from "~/assets/images/onionRings.JPG";
import reviewAuthors from "~/assets/images/review-authors.png";
---

<Layout title="Início" pageTitle="Início" description="Bem-vindo à Swiss Grill, sua hamburgueria em São Paulo.">
	<Section class:list={"bg-gray-dark"}>
		<div class="mb-16 rounded-[2rem] border border-white/10 bg-black/35 px-6 py-10 shadow-2xl backdrop-blur-sm lg:px-12 lg:py-14">
			<div class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center">
				<Badge color="yellow-gold" title="Hamburgueria artesanal" />
				<div class="space-y-5">
					<p class="text-pretty text-gray-light lg:text-lg">
						Tudo começa com uma boa chapa, ingredientes frescos e aquele clima certo para comer sem pressa.
					</p>
				</div>
				<div class="flex flex-wrap justify-center gap-3 text-sm font-semibold text-yellow-bright/90">
					<span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">Entrega rápida</span>
					<span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">Pedidos online</span>
					<span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">Ambiente acolhedor</span>
				</div>
			</div>
		</div>

		<div class="mx-auto mb-16 flex max-w-4xl items-center gap-4 px-2" aria-hidden="true">
			<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/40 to-transparent"></span>
			<span class="h-2.5 w-2.5 rounded-full bg-yellow-gold shadow-[0_0_18px_rgba(200,146,47,0.7)]"></span>
			<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/40 to-transparent"></span>
		</div>

		<Hero>
			<div slot="hero-content-left" class="prose max-w-none max-lg:order-1">
				<Badge color="yellow-gold" title="Hamburgueria artesanal" />
				<h1 class="font-black">Burgers suculentos, ingredientes frescos e sabor marcante em cada mordida.</h1>

				<p>
					Na Swiss Grill, acreditamos que um grande hambúrguer começa com pão macio, blend bem preparado e ingredientes de qualidade. Do almoço ao jantar, criamos combinações que unem sabor, conforto e aquele clima perfeito para reunir a galera.
				</p>

				<span class="text-yellow-gold font-medium">✔ Também fazemos entrega</span>

				<div class="mt-8 flex items-center gap-x-8">
					<Button color="yellow-gold" url="/order">Pedir agora</Button>
					<ButtonCallUs />
				</div>
			</div>
			<div slot="hero-content-right">
				<Picture
					class:list={"mx-auto"}
					src={burgerFeature}
					height={600}
					formats={["avif", "webp"]}
					alt="Hambúrguer artesanal em destaque"
					loading={"eager"}
					fetchpriority={"high"}
				/>
			</div>
		</Hero>
	</Section>

	<WideImage image={burgerShowcase} alt="Burger premium servido no prato" class:list={"aspect-video lg:aspect-[16/6] rounded-none"} />

	<div class="mx-auto my-10 flex max-w-5xl items-center gap-4 px-4 lg:my-14" aria-hidden="true">
		<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/30 to-transparent"></span>
		<span class="h-2.5 w-2.5 rounded-full bg-yellow-gold shadow-[0_0_18px_rgba(200,146,47,0.7)]"></span>
		<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/30 to-transparent"></span>
	</div>

	<Section class:list={"bg-gray-dark"}>
		<Heading>
			<h2 slot="heading-title" class="font-black text-yellow-gold h2">Nossos destaques</h2>
			<p slot="heading-content" class="text-gray-light">
				Os favoritos da casa, organizados por categoria para facilitar a escolha.
			</p>
		</Heading>

		<Grid>
			<div slot="grid-content-1">
				<div class="flex flex-col items-center prose text-center bg-gray-dark/50 rounded-lg p-6 border border-gray-dark/50">
					<Picture
						class:list={"not-prose w-full h-auto rounded-lg"}
						src={prepOne}
						formats={["avif", "webp"]}
						alt="Preparação de hambúrguer na chapa"
					/>
					<h3 class="h4 mt-4 font-black text-yellow-gold">Burgers da Casa</h3>
					<p class="text-gray-light">
						Da receita clássica ao smash burger, nossos lanches são montados na hora com carnes selecionadas, queijo derretido e molhos especiais.
					</p>
				</div>
			</div>

			<div slot="grid-content-2">
				<div class="flex flex-col items-center prose text-center bg-gray-dark/50 rounded-lg p-6 border border-gray-dark/50">
					<Picture
						class:list={"not-prose w-full h-auto rounded-lg"}
						src={fries}
						formats={["avif", "webp"]}
						alt="Batatas fritas crocantes"
					/>
					<h3 class="h4 mt-4 font-black text-yellow-gold">Acompanhamentos</h3>
					<p class="text-gray-light">
						Complemente seu pedido com batata crocante, onion rings e porções perfeitas para compartilhar sem abrir mão do sabor.
					</p>
				</div>
			</div>

			<div slot="grid-content-3">
				<div class="flex flex-col items-center prose text-center bg-gray-dark/50 rounded-lg p-6 border border-gray-dark/50">
					<Picture
						class:list={"not-prose w-full h-auto rounded-lg"}
						src={onionRings}
						formats={["avif", "webp"]}
						alt="Porcao de onion rings"
					/>
					<h3 class="h4 mt-4 font-black text-yellow-gold">Combos completos</h3>
					<p class="text-gray-light">
						Escolha seu burger favorito com batata e bebida por um preço especial. Ideal para o almoço corrido ou para curtir sem pressa.
					</p>
				</div>
			</div>
		</Grid>

		<div class="mx-auto my-10 flex max-w-4xl items-center gap-4 px-2" aria-hidden="true">
			<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/40 to-transparent"></span>
			<span class="h-2.5 w-2.5 rounded-full bg-yellow-gold shadow-[0_0_18px_rgba(200,146,47,0.7)]"></span>
			<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/40 to-transparent"></span>
		</div>

	<Section class:list={"bg-gray-dark"}>
		   <Hero>
			   <div slot="hero-content-left" class="prose lg:order-2">
				   <h1 class="font-black text-yellow-gold">Hambúrgueres artesanais</h1>

				   <p class="text-gray-light">
					   Nossos hambúrgueres são preparados com blends selecionados, pão sempre fresco e combinações de ingredientes que equilibram textura e sabor em cada mordida.
				   </p>

				   <p class="text-gray-light">
					   Seja para um almoço rápido, um jantar com amigos ou aquele lanche caprichado no fim do dia, a experiência aqui é feita para quem ama burger de verdade.
				   </p>

				   <div class="mt-8">
					   <Button url="/menu">
						   <svg
							   xmlns="http://www.w3.org/2000/svg"
							   viewBox="0 0 20 20"
							   fill="currentColor"
							   class="size-5 inline-block"
							   aria-hidden="true"
						   >
							   <path
								   fill-rule="evenodd"
								   d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z"
								   clip-rule="evenodd"></path>
						   </svg>
						   Ver cardápio
					   </Button>
				   </div>
			   </div>
			   <div slot="hero-content-right">
				   <Picture
					   class:list={"mx-auto"}
					   src={burgerFeature}
					   height={600}
					   formats={["avif", "webp"]}
					   alt="Hambúrguer artesanal"
				   />
			   </div>
		   </Hero>
	</Section>

	<div class="mx-auto my-10 flex max-w-4xl items-center gap-4 px-2" aria-hidden="true">
		<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/40 to-transparent"></span>
		<span class="h-2.5 w-2.5 rounded-full bg-yellow-gold shadow-[0_0_18px_rgba(200,146,47,0.7)]"></span>
		<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/40 to-transparent"></span>
	</div>

	<Section class:list={"bg-gray-dark"}>
		<Hero>
			<div slot="hero-content-left" class="prose max-w-none max-lg:order-1">
				<Badge color="yellow" title="delicious" />
				<h2 class="font-black h2 !my-4 text-yellow-gold">Prato da semana</h2>

				<span class="text-yellow-bright text-2xl font-bold italic">Smash Bacon Duplo!</span>

				<p class="text-gray-light">
					Toda semana destacamos uma criação especial da casa. Desta vez, o Smash Bacon Duplo chega com duas carnes prensadas, cheddar cremoso, bacon crocante e molho da casa no pão brioche. Aproveite por tempo limitado.
				</p>

				<div class="mt-8">
					<Button color="yellow-gold" url="/order">Pedir agora</Button>
				</div>
			</div>
			<div slot="hero-content-right">
				<Picture
					class:list={"mx-auto"}
						src={burgerShowcase}
					height={600}
					formats={["avif", "webp"]}
					alt="Burger premium com acompanhamentos"
				/>
			</div>
		</Hero>
	</Section>

	<div class="mx-auto my-10 flex max-w-4xl items-center gap-4 px-2" aria-hidden="true">
		<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/40 to-transparent"></span>
		<span class="h-2.5 w-2.5 rounded-full bg-yellow-gold shadow-[0_0_18px_rgba(200,146,47,0.7)]"></span>
		<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/40 to-transparent"></span>
	</div>

	<!-- Reviews -->
	<Section class:list={"bg-gray-dark relative"}>
		<div class="py-16">
			<Hero>
				<div slot="hero-content-left" class="prose max-w-none order-2">
					<div class="text-center not-prose">
						<Badge color="yellow-gold" title="reviews" />
					</div>
					<h2 slot="heading-title" class="font-black h4 text-center mt-0 mb-4 text-yellow-gold">O que nossos clientes dizem...</h2>
					<div slot="heading-content">
						<p class="text-center text-gray-light">
							Não acredite só na nossa palavra. Veja o que nossos clientes dizem sobre a experiência
							com nossos hambúrgueres, atendimento e ambiente.
						</p>

						<ReviewSlider />
					</div>
				</div>

				<div slot="hero-content-right">
					<Picture src={reviewAuthors} alt="Autores das avaliações" class="w-full h-auto" />
				</div>
			</Hero>
		</div>

		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1440 320"
			class="absolute h-40 w-full top-0 inset-x-0 rotate-180"
			preserveAspectRatio="none"
			><path
				fill="#ffffff"
				fill-opacity="1"
				d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
			></path>
		</svg>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1440 320"
			class="absolute h-40 w-full bottom-0 inset-x-0"
			preserveAspectRatio="none"
			><path
				fill="#ffffff"
				fill-opacity="1"
				d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
			></path>
		</svg>
	</Section>

	<div class="mx-auto my-10 flex max-w-4xl items-center gap-4 px-2" aria-hidden="true">
		<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/40 to-transparent"></span>
		<span class="h-2.5 w-2.5 rounded-full bg-yellow-gold shadow-[0_0_18px_rgba(200,146,47,0.7)]"></span>
		<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/40 to-transparent"></span>
	</div>

	<!-- Desserts -->
	<Section class:list={"bg-gray-dark"}>
		<Hero>
			<div slot="hero-content-left" class="prose max-w-none order-2">
				<Badge color="yellow-gold" title="doces" />
				<h2 slot="heading-title" class="font-black text-yellow-gold h2 !my-4">Sobremesas</h2>
				<div slot="heading-content">
					<p class="text-gray-light">
						Delicie-se com nossa seleção de doces, do clássico tiramisù ao bolo de chocolate mais 
						decadente. Nossas sobremesas são a maneira perfeita de encerrar sua refeição.
					</p>

					<p class="text-gray-light">
						Perfeitas para acompanhar seu burger ou para matar a vontade de doce, nossas sobremesas são preparadas para fechar a refeição com chave de ouro.
						No salão, para retirada ou delivery, prometemos uma experiência memorável.
					</p>

					<div class="mt-8">
						<Button color="yellow-gold" url="/menu">Veja nosso cardápio</Button>
					</div>
				</div>
			</div>

			<div slot="hero-content-right">
				<Picture
					class:list={"mx-auto"}
					src={prato}
					height={600}
					formats={["avif", "webp"]}
					alt="Imagem de sobremesa"
				/>
			</div>
		</Hero>
	</Section>

	<div class="mx-auto my-10 flex max-w-4xl items-center gap-4 px-2" aria-hidden="true">
		<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/40 to-transparent"></span>
		<span class="h-2.5 w-2.5 rounded-full bg-yellow-gold shadow-[0_0_18px_rgba(200,146,47,0.7)]"></span>
		<span class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-gold/40 to-transparent"></span>
	</div>

	<!-- Contact -->
	<Section class:list={"bg-gray-dark"}>
		<Hero>
			<div slot="hero-content-left" class="prose max-w-none">
				<Badge color="yellow" title="venha provar" />
				<h2 slot="heading-title" class="font-black text-yellow-bright h2 !my-4">Venha nos visitar</h2>
				<div slot="heading-content">
					<p class="text-gray-light">
						Estamos no coração da cidade, a poucos passos da praça principal. 
						Nossa hamburgueria é o lugar perfeito para curtir burgers incríveis com amigos e família.
					</p>

					<span class="text-yellow-gold font-medium">
						✔ Também fazemos retirada (take-away), para você aproveitar em casa
					</span>

					<div class="mt-8">
						<Button color="yellow-gold" url="/order">Pedir agora</Button>
					</div>
				</div>
			</div>

			<div slot="hero-content-right">
				<Picture
					class:list={"mx-auto"}
					src={prato}
					height={600}
					formats={["avif", "webp"]}
					alt="Imagem ilustrativa"
				/>
			</div>
		</Hero>
	</Section>
</Layout>

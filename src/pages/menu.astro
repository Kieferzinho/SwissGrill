---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Badge from "~/components/Badge.astro";
import { Picture } from "astro:assets";
import MenuList from "~/components/Menu.astro";
import menuBoard from "~/assets/images/menuHamburgeria.jfif";
---

<Layout>
	<Section class:list={"bg-gray-dark"}>
		<div class="mb-16 rounded-[2rem] border border-white/10 bg-black/35 px-6 py-10 shadow-2xl backdrop-blur-sm lg:px-12 lg:py-14">
			<div class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center">
				<Badge color="yellow-gold" title="Cardápio" />
				<div class="space-y-5">
					<h1 class="font-black text-yellow-gold h2">Nosso cardápio</h1>
					<p class="text-pretty text-gray-light lg:text-lg">
						Explore nossos burgers artesanais, combos completos, acompanhamentos crocantes e sobremesas da casa.
					</p>
				</div>
				<div class="flex flex-wrap justify-center gap-3 text-sm font-semibold text-yellow-bright/90">
					<span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">Burgers artesanais</span>
					<span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">Combos completos</span>
					<span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">Acompanhamentos</span>
				</div>
			</div>
		</div>

		<div class="mb-16 overflow-hidden rounded-[2rem] border border-white/10 bg-black/25 shadow-2xl backdrop-blur-sm">
			<Picture
				src={menuBoard}
				alt="Cardápio da hamburgueria com os principais burgers"
				class="h-full w-full object-cover object-center"
				style="aspect-ratio: 3 / 4"
				width={1200}
				height={1600}
				loading="eager"
				fetchpriority="high"
			/>
		</div>

		<MenuList />
	</Section>
</Layout>

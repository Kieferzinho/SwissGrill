---
const { color = "yellow-gold", url = "", newtab = false, As = "a", ...props } = Astro.props;
// Cores disponíveis: yellow-gold, yellow, black, gray-dark
---

<As
	class={`not-prose button button-${color}`}
	href={url}
	target={newtab ? "_blank" : "_self"}
	rel={newtab ? "noopener noreferrer" : ""}
	{...props}
>
	<slot />
</As>

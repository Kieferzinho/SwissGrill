---
import { getCollection } from "astro:content";
const allReviews = await getCollection("reviews");
---

<div class="swiper w-full mt-8 overflow-hidden rounded-3xl border border-white/10 bg-black/35 shadow-2xl backdrop-blur-sm">
	<div class="swiper-wrapper h-auto w-auto px-2 py-10 lg:px-4 lg:py-12">
		{
			allReviews.map((review) => (
				<div class="swiper-slide cursor-pointer select-none">
					<div class="mx-auto flex h-full max-w-3xl flex-col justify-center px-4 lg:px-10">
						<blockquote class="border-none">
							<p class="text-center font-medium text-xl lg:text-2xl leading-relaxed text-gray-light text-balance">
								{review.data.review}
							</p>
							<footer class="mt-6 text-center text-sm lg:text-base text-yellow-gold">
								— <cite class="not-italic font-semibold text-white">{review.data.author}</cite>
							</footer>
						</blockquote>
					</div>
				</div>
			))
		}
	</div>
	<div class="swiper-pagination !bottom-4"></div>
</div>

<script>
	import Swiper from "swiper";
	import { Pagination, Autoplay } from "swiper/modules";
	import "swiper/css";
	import "swiper/css/pagination";

	document.addEventListener("astro:page-load", () => {
		const swiper = document.querySelector(".swiper") as HTMLElement;
		new Swiper(swiper, {
			modules: [Pagination, Autoplay],
			loop: true,
			slidesPerView: 1,
			spaceBetween: 32,
			autoplay: {
				delay: 2500,
			},
			pagination: {
				el: ".swiper-pagination",
			},
		});
	});
</script>
